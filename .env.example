# 前端构建配置
VITE_API_BASE=http://127.0.0.1:3001

# 后端基础配置
PORT=3001
DB_PATH=./server/data/fuchong.db
PUBLIC_API_BASE=http://127.0.0.1:3001
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=123456789

# 飞书多维表格（App Secret 只放部署环境，不提交 Git）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# 飞书网站客服应用（与上面的商品多维表格同步应用严格隔离）
FEISHU_SERVICE_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_SERVICE_APP_SECRET=
FEISHU_SERVICE_VERIFICATION_TOKEN=
FEISHU_SERVICE_AGENT_TOKEN_SECRET=replace-with-a-separate-long-random-secret
FEISHU_SERVICE_API_BASE=https://open.feishu.cn
APP_ORIGIN=https://your-domain.example

# 微信支付
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=./server/certs/apiclient_key.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./server/certs/wechatpay_platform.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/payments/wechat/notify
# 移动客服工作台 Web Push（生产环境必须重新生成）
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:service@petinmyall.me
# 仅启用由维护表格生成的 2500 条客服语料；关闭时只返回安全澄清话术。
CUSTOMER_SERVICE_CORPUS_ENABLED=1
CUSTOMER_SERVICE_AUTO_RESUME_SECONDS=30
